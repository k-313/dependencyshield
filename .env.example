# ==============================================================================
# DependencyShield Environment Configuration Example
# Copy this file to .env in your root / backend directory
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development
PROJECT_NAME="DependencyShield"

# Server Network Interface & Port (0.0.0.0 binds to all network interfaces for LAN / VM access)
HOST=0.0.0.0
PORT=8000

# Backend Secret Key (generate a secure random 32+ char string in production)
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string

# Database Connection URL
# For local development / zero-setup lightweight testing (default):
DATABASE_URL=sqlite:///./dependencyshield.db
# For production Neon PostgreSQL or self-hosted PostgreSQL:
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/dependencyshield?sslmode=require

# Google OSV Security Intelligence API
OSV_API_BASE_URL=https://api.osv.dev/v1
OSV_BATCH_SIZE=100
OSV_TIMEOUT_SECONDS=15.0
OSV_MAX_RETRIES=3
OSV_CACHE_TTL_HOURS=24

# AI Security Advisor (Optional)
# If provided, enables Gemini-powered plain-English impact and remediation synthesis.
# If omitted, DependencyShield automatically falls back to authoritative rule-based guidance.
# GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
